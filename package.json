{
  "name": "tavora-desktop",
  "version": "1.0.6",
  "description": "Tavora desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -k \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend && electron-builder --win",
    "release": "npm run build -- --publish always",
    "start": "electron ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.tavora.desktop",
    "productName": "Tavora",
    "publish": {
      "provider": "github",
      "owner": "fiskedxd",
      "repo": "tevora-frontend",
      "releaseType": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "backend/**/*",
      "frontend/public/musiques/**/*",
      "frontend/public/covers/**/*",
      "frontend/public/playlist-covers/**/*",
      "frontend/public/playlist-banners/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/public/tevora.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tavora",
      "installerSidebar": "build/installer/sidebar.bmp",
      "installerHeader": "build/installer/header.bmp"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
